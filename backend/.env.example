# =============================================================================
# SIH Water Footprint App — Backend Environment Variables (TEMPLATE)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=SIH-Water-Footprint-API
APP_ENV=development
DEBUG=true
APP_SECRET_KEY=          # Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── CORS (comma-separated origins allowed to call this API) ─────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000,http://10.0.2.2:8000

# ─── Database (Dishita's module — feature/database) ─────────────────────────
DATABASE_URL=sqlite:///./database/data/water_footprint.sqlite

# ─── ML Model (Kuhu's module — feature/ml-recognition) ──────────────────────
ML_MODEL_PATH=../ml_model/models
ML_CONFIDENCE_THRESHOLD=0.6
MAX_UPLOAD_SIZE_MB=10

# ─── Translation (Vanshita's module — feature/multilingual) ─────────────────
GOOGLE_TRANSLATE_API_KEY=    # Get from https://console.cloud.google.com
TRANSLATION_CACHE_TTL_SECONDS=3600
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi
TRANSLATION_OVERRIDES_PATH=../multilingual/data/overrides.json

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Temporary Upload Directory ──────────────────────────────────────────────
TEMP_UPLOAD_DIR=./tmp/uploads
